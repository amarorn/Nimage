{
  "name": "Nimage",
  "version": "1.2.0",
  "description": "API em Node.js com TypeScript seguindo Clean Architecture",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:docker": "./scripts/dev.sh",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "test": "jest",
    "generate-training-data": "ts-node src/scripts/generateTrainingData.ts",
    "generate-metas": "ts-node src/scripts/generateMetas.ts",
    "generate-activities": "ts-node src/scripts/generateActivities.ts",
    "prepare-training": "ts-node src/scripts/prepareTrainingData.ts",
    "train-model": "ts-node src/domain/models/trainModel.ts",
    "train-ollama": "ts-node src/domain/models/ollamaTrainer.ts",
    "train-ollama-simple": "ts-node src/scripts/trainOllamaSimple.ts",
    "setup-gitflow": "./scripts/setup-gitflow.sh",
    "test:coverage": "nyc npm test",
    "test:coverage:report": "nyc --reporter=text --reporter=lcov npm test",
    "coveralls": "nyc --reporter=lcov npm test && cat ./coverage/lcov.info | coveralls"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.17.0",
    "@types/axios": "^0.14.4",
    "@types/dotenv": "^8.2.3",
    "@types/ioredis": "^5.0.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.8.4",
    "badge-maker": "^4.1.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "flatted": "^3.3.2",
    "inversify": "^7.2.0",
    "ioredis": "^5.6.0",
    "mongodb": "^6.13.0",
    "mongoose": "^8.10.1",
    "node-fetch": "^2.7.0",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-babel": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^20.17.28",
    "@types/node-fetch": "^2.6.12",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.0.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.3"
  },
  "private": true,
  "nyc": {
    "extends": "@istanbuljs/nyc-config-babel",
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "src/**/*.spec.ts",
      "src/**/__tests__/**",
      "src/**/__mocks__/**"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ],
    "report-dir": "./coverage",
    "check-coverage": {
      "statements": 80,
      "branches": 80,
      "functions": 80,
      "lines": 80
    }
  }
}
