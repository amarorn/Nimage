[gitflow "branch"]
    master = master
    develop = develop
    feature = feature/
    release = release/
    hotfix = hotfix/
    support = support/
    versiontag = v

[gitflow "prefix"]
    feature = feature/
    release = release/
    hotfix = hotfix/
    support = support/
    versiontag = v

[gitflow "path"]
    hooks = .git/hooks

[gitflow "options"]
    nosquash = false
    nolog = false
    nodebug = false
    keepremote = false
    keepbranch = false
    fetchall = false
    rebase = false
    autostash = true
    verbose = false
    force = false
    showcommands = false
    warnonerrors = true 